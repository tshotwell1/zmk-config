#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    chosen { zmk,matrix_transform = &default_transform; };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&hm ESCAPE Q      &kp W        &kp E           &kp R           &kp T            &kp Y     &kp U            &kp I            &kp O        &kp P
&hm LEFT_SHIFT A  &hm LCTRL S  &hm LEFT_WIN D  &hm LEFT_ALT F  &kp G            &kp H     &hm RIGHT_ALT J  &hm RIGHT_WIN K  &hm RCTRL L  &hm RIGHT_SHIFT SEMICOLON
&kp Z             &kp X        &kp C           &kp V           &kp B            &kp N     &kp M            &kp COMMA        &kp PERIOD   &kp SLASH
&kp F1            &kp F2       &kp ENTER       &kp SPACE       &kp BACKSPACE    &lt 1 F7  &lt 4 F8         &lt 3 F9         &kp SQT      &kp MINUS
                               &lt 4 F4        &lt 2 F5        &lt 1 F6
            >;
        };

        prog_layer {
            bindings = <
&hm ESCAPE Q      &kp W        &kp E           &kp R           &kp T            &kp EXCLAMATION  &kp POUND      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&hm LEFT_SHIFT A  &hm LCTRL S  &hm LEFT_WIN D  &hm LEFT_ALT F  &kp G            &kp AT           &kp EQUAL      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp COLON
&kp Z             &kp X        &kp C           &kp V           &kp B            &kp PERCENT      &kp AMPERSAND  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SLASH
&kp F1            &kp F2       &kp ENTER       &kp SPACE       &kp BACKSPACE    &trans           &trans         &trans                &kp SQT                &kp MINUS
                               &lt 0 F4        &lt 2 F5        &lt 1 F6
            >;
        };

        num_layer {
            bindings = <
&trans  &trans           &trans    &trans    &trans      &kp ASTRK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
&trans  &kp PRINTSCREEN  &trans    &trans    &trans      &kp SLASH  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS
&trans  &trans           &trans    &trans    &trans      &trans     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans  &trans           &trans    &trans    &trans      &trans     &trans        &trans        &kp NUMBER_0  &kp PERIOD
                         &lt 0 F4  &lt 2 F5  &lt 1 F6
            >;
        };

        nav_layer {
            bindings = <
&kp LA(TAB)   &trans          &kp UP_ARROW    &trans           &trans    &trans  &trans      &trans      &trans      &trans
&kp CAPSLOCK  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans    &trans  &kp RC(F1)  &kp RC(F2)  &kp RC(F3)  &kp RC(F4)
&trans        &trans          &trans          &trans           &trans    &trans  &trans      &trans      &trans      &trans
&trans        &trans          &trans          &trans           &trans    &trans  &trans      &trans      &trans      &trans
                              &trans          &trans           &trans
            >;
        };

        media_layer {
            bindings = <
&trans  &trans  &trans          &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp C_PREVIOUS  &kp C_PP           &kp C_NEXT              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans             &trans                  &trans  &trans  &trans  &trans  &trans
                &trans          &trans             &trans
            >;
        };
    };
};
