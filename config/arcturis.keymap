#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    input_processors {
        scroll_div: scroll_div {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>, <INPUT_REL_HWHEEL>;

            track-remainders;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&hm ESCAPE Q      &kp W        &kp E           &kp R           &kp T            &kp Y     &kp U            &kp I            &kp O        &kp P
&hm LEFT_SHIFT A  &hm LCTRL S  &hm LEFT_WIN D  &hm LEFT_ALT F  &kp G            &kp H     &hm RIGHT_ALT J  &hm RIGHT_WIN K  &hm RCTRL L  &hm RIGHT_SHIFT SEMICOLON
&kp Z             &kp X        &kp C           &kp V           &kp B            &kp N     &lt 1 M          &kp COMMA        &kp PERIOD   &kp SLASH
&lt 5 F1          &kp F2       &kp ENTER       &kp SPACE       &kp BACKSPACE    &lt 1 F7  &lt 4 F8         &lt 3 F9         &kp SQT      &kp MINUS
                               &lt 4 F4        &lt 2 F5        &lt 1 F6
            >;
        };

        prog_layer {
            bindings = <
&hm ESCAPE Q      &kp W        &kp E           &kp R           &kp T       &kp EXCLAMATION  &kp POUND      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&hm LEFT_SHIFT A  &hm LCTRL S  &hm LEFT_WIN D  &hm LEFT_ALT F  &kp G       &kp AT           &kp EQUAL      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp COLON
&kp Z             &kp X        &kp C           &kp V           &kp B       &kp PERCENT      &kp AMPERSAND  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SLASH
&kp F1            &kp F2       &mkp MB3        &mkp MB1        &mkp MB2    &trans           &trans         &trans                &kp SQT                &kp MINUS
                               &lt 0 F4        &lt 2 F5        &lt 1 F6
            >;
        };

        num_layer {
            bindings = <
&trans  &trans           &trans    &trans    &trans      &kp ASTRK  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
&trans  &kp PRINTSCREEN  &trans    &trans    &trans      &kp SLASH  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS
&trans  &trans           &trans    &trans    &trans      &trans     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans  &trans           &trans    &trans    &trans      &trans     &trans        &trans        &kp NUMBER_0  &kp PERIOD
                         &lt 0 F4  &lt 2 F5  &lt 1 F6
            >;
        };

        nav_layer {
            bindings = <
&kp LA(TAB)   &mkp MB4        &kp UP_ARROW    &mkp MB5         &trans    &trans  &trans      &trans      &trans      &trans
&kp CAPSLOCK  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans    &trans  &kp RC(F1)  &kp RC(F2)  &kp RC(F3)  &kp RC(F4)
&trans        &trans          &trans          &trans           &trans    &trans  &trans      &trans      &trans      &trans
&trans        &trans          &trans          &trans           &trans    &trans  &trans      &trans      &trans      &trans
                              &trans          &trans           &trans
            >;
        };

        /* Holding F4 or F8 makes the trackball scroll - see the listener
         * override at the bottom of this file.
         * &bootloader is source-specific: the bottom-left key puts the LEFT
         * half into bootloader, the bottom-right key the RIGHT half. */

        media_layer {
            bindings = <
&trans       &trans  &trans          &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans       &trans  &kp C_PREVIOUS  &kp C_PP           &kp C_NEXT              &trans        &trans        &trans        &trans        &trans
&trans       &trans  &trans          &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_DEC    &bt BT_CLR    &trans        &trans        &trans        &trans
&bootloader  &trans  &trans          &trans             &trans                  &trans        &trans        &trans        &trans        &bootloader
                     &trans          &trans             &studio_unlock
            >;
        };

        /* Scrolling with the opposite vertical direction, held via F1. Scroll
         * direction is a coin flip until you try it, so both are wired up in
         * this one build: hold F4 for one direction, F1 for the other. Once
         * you know which you want, delete the one you don't and drop F1 back
         * to &kp F1. Every key here is transparent, so typing is unaffected. */

        scroll_alt_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans
            >;
        };
    };
};

/* Turn the trackball into a scroll ball on layer 4 (hold F4 or F8), and on
 * layer 5 (hold F1) with the vertical direction flipped.
 *
 * Order matters: the mapper turns X/Y into horizontal/vertical wheel events,
 * then scroll_div divides them down. The ball is 800 CPI, about 315 counts per
 * cm, so a divisor of 48 gives roughly 6 scroll ticks per cm of ball travel.
 * Lower the divisor to scroll faster, raise it to scroll slower.
 *
 * The transform runs before the mapper because it acts on X/Y, not on wheel
 * codes. It only applies on this layer, so pointer direction is untouched. */

&trackball_listener {
    scroller {
        layers = <4>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&scroll_div 1 48>;
    };

    scroller_inverted {
        layers = <5>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&zip_xy_to_scroll_mapper>,
            <&scroll_div 1 48>;
    };
};
